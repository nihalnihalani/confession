# Replay QA — get token after applying promo code HACKATHON in Replay settings
REPLAY_API_TOKEN=lqa_xxx
# Spec self-declares qa.replay.io; docs page used loop-qa.replay.io. Verify on-site which answers.
REPLAY_BASE_URL=https://qa.replay.io
REPLAY_API_PREFIX=/api/v1
# Target app the Builder works on (deployed URL Replay will explore)
TARGET_APP_URL=http://localhost:4000
# Pioneer — X-API-Key auth; verify model via GET /v1/models before use.
# After fine-tune: set PIONEER_MODEL to the training-job ID (it IS the model ID).
PIONEER_API_KEY=pio_sk_xxx
PIONEER_MODEL=gpt-4.1-mini
PIONEER_BASE_URL=https://api.pioneer.ai
# Guild auth lives in `guild auth login` CLI state — no env var needed.
GUILD_WORKSPACE=confession/confession
# Tier ratchet: consecutive VERIFIED passes required for promotion
CONFESSION_RATCHET_N=3
# GitHub token for target-app patches (or use gh CLI auth)
GITHUB_TOKEN=
# Builder loop (autonomous claim origination)
TASKS_FILE=target-app/TASKS.md
GUILD_BUILDER_AGENT=confession~confession-builder-l0
GUILD_BUILDER_L1_AGENT=confession~confession-builder-l1
CONFESSION_BUILDER_AGENT_ID=builder
BUILDER_TIMEOUT_S=600
# Identity: only listed agents can ratchet tiers; judge identities audit but never ratchet
CONFESSION_ALLOWED_AGENTS=builder
CONFESSION_JUDGE_AGENTS=judge
# Autonomous re-audit of PENDING claims
REAUDIT_INTERVAL_S=120
REAUDIT_MAX_ATTEMPTS=3
# CORS (comma list) for a deployed dashboard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
